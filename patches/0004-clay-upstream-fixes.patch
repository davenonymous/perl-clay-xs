+uint32_t Clay__ResolvePendingClipElementId(Clay__LayoutElementTreeRoot *root, int32_t depth);
+
+// The clip element id of the element with the given id, now that the whole frame is declared. When that element is,
+// or sits in, a floating element whose own clip element is still pending, that one is resolved first.
+uint32_t Clay__ClipElementIdOfElement(uint32_t elementId, int32_t depth) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    Clay_LayoutElementHashMapItem *item = Clay__GetHashMapItem(elementId);
+    if (item->generation <= context->generation) { // Not declared in this frame
+        context->errorHandler.errorHandlerFunction(CLAY__INIT(Clay_ErrorData) {
+                .errorType = CLAY_ERROR_TYPE_FLOATING_CONTAINER_PARENT_NOT_FOUND,
+                .errorText = CLAY_STRING("A floating element was declared with a parentId, but no element with that ID was found."),
+                .userData = context->errorHandler.userData });
+        return 0;
+    }
+    int32_t elementIndex = (int32_t)(item->layoutElement - context->layoutElements.internalArray);
+    uint32_t clipElementId = (uint32_t)Clay__int32_tArray_GetValue(&context->layoutElementClipElementIds, elementIndex);
+    for (int32_t rootIndex = 0; rootIndex < context->layoutElementTreeRoots.length; ++rootIndex) {
+        Clay__LayoutElementTreeRoot *root = Clay__LayoutElementTreeRootArray_Get(&context->layoutElementTreeRoots, rootIndex);
+        if (!root->clipElementPending) {
+            continue;
+        }
+        Clay_LayoutElement *pendingElement = Clay_LayoutElementArray_Get(&context->layoutElements, root->layoutElementIndex);
+        bool isTheElement = root->layoutElementIndex == elementIndex;
+        bool inheritedItsStandIn = pendingElement->id == clipElementId && pendingElement->config.floating.clipTo != CLAY_CLIP_TO_NONE
+            && !pendingElement->config.clip.horizontal && !pendingElement->config.clip.vertical;
+        if (isTheElement || inheritedItsStandIn) {
+            return Clay__ResolvePendingClipElementId(root, depth + 1);
+        }
+    }
+    return clipElementId;
+}
+
+// Looks up the clip element of a floating element attached to an element declared after it (reporting a target that
+// never came) and replaces the stand-in it was declared with (its own id, see Clay__ConfigureOpenElementPtr). Only a
+// clipping element pushes its own id on the clip stack, so unless the floating element clips, every element and tree
+// root carrying its id inherited the stand-in; when it clips, its descendants are clipped by it and only its own
+// entry is replaced. Attachments that lead around in a circle end unclipped.
+uint32_t Clay__ResolvePendingClipElementId(Clay__LayoutElementTreeRoot *root, int32_t depth) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    Clay_LayoutElement *rootElement = Clay_LayoutElementArray_Get(&context->layoutElements, root->layoutElementIndex);
+    uint32_t targetClipElementId = depth > context->layoutElementTreeRoots.length ? 0 : Clay__ClipElementIdOfElement(root->parentId, depth);
+    uint32_t clipElementId = rootElement->config.floating.clipTo == CLAY_CLIP_TO_NONE ? 0 : targetClipElementId;
+    root->clipElementPending = false;
+    root->clipElementId = clipElementId;
+    Clay__int32_tArray_Set(&context->layoutElementClipElementIds, root->layoutElementIndex, (int32_t)clipElementId);
+    if (rootElement->config.floating.clipTo == CLAY_CLIP_TO_NONE || rootElement->config.clip.horizontal || rootElement->config.clip.vertical) {
+        return clipElementId;
+    }
+    for (int32_t i = 0; i < context->layoutElements.length; ++i) {
+        if ((uint32_t)Clay__int32_tArray_GetValue(&context->layoutElementClipElementIds, i) == rootElement->id) {
+            Clay__int32_tArray_Set(&context->layoutElementClipElementIds, i, (int32_t)clipElementId);
+        }
+    }
+    for (int32_t rootIndex = 0; rootIndex < context->layoutElementTreeRoots.length; ++rootIndex) {
+        Clay__LayoutElementTreeRoot *other = Clay__LayoutElementTreeRootArray_Get(&context->layoutElementTreeRoots, rootIndex);
+        if (other->clipElementId == rootElement->id) {
+            other->clipElementId = clipElementId;
+        }
+    }
+    return clipElementId;
+}
+
+void Clay__ResolvePendingClipElementIds(void) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    for (int32_t rootIndex = 0; rootIndex < context->layoutElementTreeRoots.length; ++rootIndex) {
+        Clay__LayoutElementTreeRoot *root = Clay__LayoutElementTreeRootArray_Get(&context->layoutElementTreeRoots, rootIndex);
+        if (root->clipElementPending) {
+            Clay__ResolvePendingClipElementId(root, 0);
+        }
+    }
+}
