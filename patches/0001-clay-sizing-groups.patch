+// Equalizes the per-axis dimensions of elements that share a sizing group id.
+// Walks all layout elements twice: first to compute the max fit-size per group,
+// then to write that max back to every member. PERCENT and FIXED elements do
+// not participate (their sizes are independent of content). Returns true if
+// any element's dimension actually changed, allowing the caller to skip a
+// follow-up propagation pass when nothing was equalized.
+bool Clay__EqualizeSizingGroups(bool xAxis) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    Clay__SizingGroupEntryArray* groups = xAxis ? &context->sizingGroupsX : &context->sizingGroupsY;
+    groups->length = 0;
+
+    for (int32_t i = 0; i < context->layoutElements.length; ++i) {
+        Clay_LayoutElement* element = Clay_LayoutElementArray_Get(&context->layoutElements, i);
+        if (element->isTextElement) continue;
+        uint32_t groupId = xAxis ? element->config.sizingGroup.width : element->config.sizingGroup.height;
+        if (groupId == 0) continue;
+        Clay__SizingType sizingType = xAxis ? element->config.layout.sizing.width.type
+                                            : element->config.layout.sizing.height.type;
+        if (sizingType == CLAY__SIZING_TYPE_FIXED || sizingType == CLAY__SIZING_TYPE_PERCENT) continue;
+        float size = xAxis ? element->dimensions.width : element->dimensions.height;
+        bool found = false;
+        for (int32_t g = 0; g < groups->length; ++g) {
+            Clay__SizingGroupEntry* entry = Clay__SizingGroupEntryArray_Get(groups, g);
+            if (entry->id == groupId) {
+                if (size > entry->maxSize) entry->maxSize = size;
+                found = true;
+                break;
+            }
+        }
+        if (!found) {
+            Clay__SizingGroupEntryArray_Add(groups, CLAY__INIT(Clay__SizingGroupEntry) { .id = groupId, .maxSize = size });
+        }
+    }
+
+    if (groups->length == 0) return false;
+
+    bool changed = false;
+    for (int32_t i = 0; i < context->layoutElements.length; ++i) {
+        Clay_LayoutElement* element = Clay_LayoutElementArray_Get(&context->layoutElements, i);
+        if (element->isTextElement) continue;
+        uint32_t groupId = xAxis ? element->config.sizingGroup.width : element->config.sizingGroup.height;
+        if (groupId == 0) continue;
+        Clay__SizingType sizingType = xAxis ? element->config.layout.sizing.width.type
+                                            : element->config.layout.sizing.height.type;
+        if (sizingType == CLAY__SIZING_TYPE_FIXED || sizingType == CLAY__SIZING_TYPE_PERCENT) continue;
+        for (int32_t g = 0; g < groups->length; ++g) {
+            Clay__SizingGroupEntry* entry = Clay__SizingGroupEntryArray_Get(groups, g);
+            if (entry->id == groupId) {
+                float* dim    = xAxis ? &element->dimensions.width    : &element->dimensions.height;
+                float* minDim = xAxis ? &element->minDimensions.width : &element->minDimensions.height;
+                if (*dim != entry->maxSize) {
+                    *dim = entry->maxSize;
+                    changed = true;
+                }
+                // Raise minDimensions to the group max so Clay's shrink-to-fit
+                // logic treats every group member uniformly: a sizing group is
+                // an indivisible unit on this axis and cannot be compressed
+                // below its largest member without breaking alignment.
+                if (*minDim < entry->maxSize) {
+                    *minDim = entry->maxSize;
+                }
+                break;
+            }
+        }
+    }
+    return changed;
+}
+
+// Walks elements in reverse declaration order (which approximates post-order
+// because children are declared after their parents in the DSL) and, for each
+// FIT container on the requested axis, re-aggregates its dimension from its
+// children's current dimensions. Elements that themselves belong to a sizing
+// group on this axis are skipped: their dimension was just set by
+// Clay__EqualizeSizingGroups and is authoritative. Used on the X axis after
+// equalization to widen parent rows; the Y axis has Clay's existing DFS
+// propagation pass which automatically picks up equalized values.
+void Clay__PropagateFitSizeUp(bool xAxis) {
+    Clay_Context* context = Clay_GetCurrentContext();
+    for (int32_t i = context->layoutElements.length - 1; i >= 0; --i) {
+        Clay_LayoutElement* element = Clay_LayoutElementArray_Get(&context->layoutElements, i);
+        if (element->isTextElement) continue;
+        if (element->children.length == 0) continue;
+        uint32_t groupId = xAxis ? element->config.sizingGroup.width : element->config.sizingGroup.height;
+        if (groupId != 0) continue;
+        Clay_SizingAxis sizing = xAxis ? element->config.layout.sizing.width
+                                       : element->config.layout.sizing.height;
+        if (sizing.type != CLAY__SIZING_TYPE_FIT) continue;
+
+        Clay_LayoutConfig* layoutConfig = &element->config.layout;
+        bool sizingAlongAxis = (xAxis && layoutConfig->layoutDirection == CLAY_LEFT_TO_RIGHT)
+                            || (!xAxis && layoutConfig->layoutDirection == CLAY_TOP_TO_BOTTOM);
+        float padding = xAxis ? (float)(layoutConfig->padding.left + layoutConfig->padding.right)
+                              : (float)(layoutConfig->padding.top + layoutConfig->padding.bottom);
+        float newSize;
+        if (sizingAlongAxis) {
+            newSize = padding;
+            for (int32_t j = 0; j < element->children.length; ++j) {
+                Clay_LayoutElement* child = Clay_LayoutElementArray_Get(&context->layoutElements, element->children.elements[j]);
+                newSize += xAxis ? child->dimensions.width : child->dimensions.height;
+            }
+            if (element->children.length > 1) {
+                newSize += (float)(element->children.length - 1) * (float)layoutConfig->childGap;
+            }
+        } else {
+            float maxChild = 0;
+            for (int32_t j = 0; j < element->children.length; ++j) {
+                Clay_LayoutElement* child = Clay_LayoutElementArray_Get(&context->layoutElements, element->children.elements[j]);
+                float c = xAxis ? child->dimensions.width : child->dimensions.height;
+                if (c > maxChild) maxChild = c;
+            }
+            newSize = maxChild + padding;
+        }
+        newSize = CLAY__MIN(CLAY__MAX(newSize, sizing.size.minMax.min), sizing.size.minMax.max);
+        if (xAxis) element->dimensions.width = newSize;
+        else element->dimensions.height = newSize;
+    }
+}
